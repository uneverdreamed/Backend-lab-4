{
  "Temporal": {
    "Address": "localhost:7233"
  },
  "Classification": {
    "StrongThreshold": 6.0,
    "ModerateThreshold": 4.5
  },
  "Simulation": {
    "ActivityDelaySeconds": 3,
    "NotifyDurationSeconds": 6,
    "FailureProbability": 0.4
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{Worker}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
